<% layout('layouts/boilerplate.ejs') %>

<body style="background: #f7f7fa;">
  <main>
    <!-- Hero Section -->
    <section class="hero-section py-5">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6 mb-4 mb-md-0">
            <h1 class="display-4 fw-bold text-primary mb-3">
              <span style="color:#ff385c;">Find Your Next Stay</span>
            </h1>
            <p class="lead text-secondary mb-4">Book unique homes and experiences around the world with our <span style="color:#ff385c;">Airbnb Clone</span>.</p>
            <a href="/listings" class="btn btn-lg btn-primary px-4 rounded-pill me-2">Explore Listings</a>
            <a href="/listings/new" class="btn btn-lg btn-danger px-4 rounded-pill">Become a Host</a>
          </div>
          <div class="col-md-6 text-center">
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80" alt="Home Hero" class="img-fluid rounded-4 shadow-lg hero-img border-red">
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section py-5 bg-white">
      <div class="container">
        <h2 class="text-center fw-bold mb-5 text-primary">
          <span style="color:#ff385c;">Why Choose Us?</span>
        </h2>
        <div class="row g-4">
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 feature-card-red">
              <i class="fa-solid fa-house-chimney fs-1 text-danger mb-3"></i>
              <h5 class="fw-semibold mb-2" style="color:#ff385c;">Unique Homes</h5>
              <p class="text-muted">Discover a variety of places to stay, from cozy cottages to luxury villas.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
              <i class="fa-solid fa-globe fs-1 text-primary mb-3"></i>
              <h5 class="fw-semibold mb-2">Global Destinations</h5>
              <p class="text-muted">Travel anywhere, anytime. Our listings span across the globe.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 feature-card-red">
              <i class="fa-solid fa-star fs-1 text-danger mb-3"></i>
              <h5 class="fw-semibold mb-2" style="color:#ff385c;">Trusted Reviews</h5>
              <p class="text-muted">Read honest reviews from real guests and book with confidence.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="cta-section py-5">
      <div class="container text-center">
        <h2 class="fw-bold mb-3 text-primary">
          <span style="color:#ff385c;">Ready to Host?</span>
        </h2>
        <p class="lead text-secondary mb-4">Share your space and earn extra income by listing your property.</p>
        <a href="/listings/new" class="btn btn-lg btn-outline-danger px-4 rounded-pill">Add New Listing</a>
      </div>
    </section>
  </main>
</body>

<style>
body {
  background: #f7f7fa;
}
.hero-section {
  min-height: 60vh;
  display: flex;
  align-items: center;
}
.hero-img {
  max-width: 90%;
  height: auto;
  border-radius: 2rem;
  box-shadow: 0 8px 32px rgba(67, 97, 238, 0.12);
}
.border-red {
  border: 4px solid #ff385c;
}
.features-section {
  background: #fff;
  border-radius: 2rem;
}
.card {
  border-radius: 1.5rem;
}
.feature-card-red {
  border-top: 4px solid #ff385c;
}
.text-primary {
  color: #4361ee !important;
}
.btn-primary {
  background-color: #4361ee;
  border-color: #4361ee;
}
.btn-outline-primary {
  border-color: #4361ee;
  color: #4361ee;
}
.btn-outline-primary:hover {
  background-color: #4361ee;
  color: #fff;
}
.btn-danger, .btn-outline-danger {
  background-color: #ff385c;
  border-color: #ff385c;
  color: #fff;
}
.btn-outline-danger {
  background: transparent;
  color: #ff385c;
}
.btn-outline-danger:hover {
  background-color: #ff385c;
  color: #fff;
}
</style>