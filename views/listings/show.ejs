<% layout('layouts/boilerplate.ejs') %>
<body>
  <div class="container">
    <!-- Listing Details Section -->
    <div class="row my-4 align-items-center">
      <div class="col-md-6">
        <div class="listing-img-wrapper shadow-sm rounded-4 overflow-hidden">
          <img src="<%= listing.image %>" alt="Listing Image" class="img-fluid w-100" />
        </div>
      </div>
      <div class="col-md-6">
        <h2 class="fw-bold text-primary mb-3"><%= listing.title %></h2>
        
        <h5>Property Owned By <%= listing.owner.username %></i></h5>
        <p class="mb-2"><span class="fw-semibold text-secondary">Description:</span> <%= listing.description %></p>
        <p class="mb-2"><span class="fw-semibold text-secondary">Price:</span> <span class="text-danger">₹<%= listing.price %></span> <span class="text-muted">/Per Night</span></p>
        <p class="mb-2"><span class="fw-semibold text-secondary">Location:</span> <%= listing.location %></p>
        <p class="mb-4"><span class="fw-semibold text-secondary">Country:</span> <%= listing.country %></p>
      
  <!-- <%    if( currUser && currUser._id.equals(listing.owner._id)) { %> -->
      <br>
        <div class="d-flex gap-2">
          <form action="/listings/<%= listing._id %>/edit" method="get">
            <button class="btn btn-warning px-4">Edit</button>
          </form>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button type="submit" class="btn btn-danger px-4">Delete</button>
          </form>
        </div>
    <!-- <%  } %> -->



      </div>
    </div>

    <!-- Add Review Section -->
    <div class="my-5">
      <h4 class="fw-bold mb-3 text-primary">Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="p-4 rounded-3 shadow-sm bg-white">
        <div class="mb-3">
          <label for="rating" class="form-label fw-semibold">Rating:</label>
          <input type="range" name="review[rating]" min="1" max="5" class="form-range" />
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comment:</label>
          <textarea name="review[comment]" class="form-control" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-outline-primary px-4">Submit</button>
      </form>
    </div>

    <!-- Display Reviews Section -->
    <div class="my-5">
      <h4 class="fw-bold mb-4 text-primary">All Reviews</h4>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        <% for (let review of listing.reviews) { %>
        <div class="col">
          <div class="card card-review shadow-sm border-0 rounded-4 h-100">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title mb-2 text-secondary"></h5>
              <p class="card-text flex-grow-1"><%= review.comment %></p>
              <h6 class="card-subtitle mb-3 text-warning">Rating: <%= review.rating %> <span>⭐</span></h6>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</body>

<style>
.listing-img-wrapper {
  max-height: 400px;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-review {
  background: #fff7f7;
  border-radius: 1.5rem;
  transition: box-shadow 0.2s;
}
.card-review:hover {
  box-shadow: 0 4px 24px rgba(255, 56, 92, 0.12);
}
.btn-outline-primary {
  border-color: #ff385c;
  color: #ff385c;
}
.btn-outline-primary:hover {
  background: #ff385c;
  color: #fff;
}
.text-primary {
  color: #ff385c !important;
}
</style>